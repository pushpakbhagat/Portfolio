# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project → Project Settings → API Keys.
# The publishable key (older projects: "anon" key) is safe in the browser: Row Level Security
# decides what it can read and write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. The secret key (older projects: "service_role" key) bypasses Row Level Security,
# so it is only read in `server-only` modules (contact form inserts) and scripts/create-admin.mjs.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Scripts only (npm run db:setup). Supabase → Connect → "Session pooler" connection string,
# with your database password filled in.
SUPABASE_DB_URL=

# Public URL of the site, used for canonical URLs, the sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Without it, contact messages are still saved and shown in the admin inbox.
# CONTACT_FROM_EMAIL must be on a domain verified in Resend (e.g. "Portfolio <hello@yourdomain.com>").
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Optional. Raises GitHub API rate limits and enables the contribution graph.
GITHUB_TOKEN=

# Optional. Secret used to hash visitor IPs for contact-form rate limiting. Any long random string.
IP_HASH_SALT=
